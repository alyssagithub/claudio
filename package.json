{
  "name": "claudio",
  "version": "1.4.0",
  "description": "Local bridge between Roblox Studio and the Claude Code login on this machine",
  "type": "module",
  "files": [
    "dist/bin",
    "dist/src",
    "src/*.ps1",
    "src/Icon.png"
  ],
  "bin": {
    "claudio": "dist/bin/claudio.js",
    "claudio-mcp": "dist/bin/mcp.js"
  },
  "scripts": {
    "start": "node dist/bin/claudio.js",
    "build": "tsc",
    "prepare": "tsc",
    "test": "tsc && node --test \"dist/test/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jpeg-js": "^0.4.4",
    "node-notifier": "^10.0.1",
    "pngjs": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/node-notifier": "^8.0.5",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "node-notifier": {
      "uuid": "^11.1.1"
    }
  }
}
