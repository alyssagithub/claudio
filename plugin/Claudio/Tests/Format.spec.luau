--!nocheck
--!nolint UnknownGlobal
return function()
	const Format = require(script.Parent.Parent.Format)

	describe("Duration", function()
		it("reads in the smallest unit that fits", function()
			expect(Format.Duration(850)).to.equal("850ms")
			expect(Format.Duration(1500)).to.equal("1.5s")
			expect(Format.Duration(61000)).to.equal("1m 1s")
			expect(Format.Duration(3600000 * 2 + 60000 * 5)).to.equal("2h 5m")
		end)
	end)

	describe("Amount", function()
		it("drops a trailing zero and rounds past ten thousand", function()
			expect(Format.Amount(999)).to.equal("999")
			expect(Format.Amount(1000)).to.equal("1k")
			expect(Format.Amount(1550)).to.equal("1.6k")
			expect(Format.Amount(12499)).to.equal("12k")
			expect(Format.Amount(12500)).to.equal("13k")
		end)
	end)

	describe("Large", function()
		it("scales to k and M", function()
			expect(Format.Large(950)).to.equal("950")
			expect(Format.Large(2000)).to.equal("2k")
			expect(Format.Large(1260000)).to.equal("1.3M")
		end)
	end)

	describe("Path", function()
		it("drops the game prefix and names nothing", function()
			expect(Format.Path("game.Workspace.Part")).to.equal("Workspace.Part")
			expect(Format.Path("Workspace.Part")).to.equal("Workspace.Part")
			expect(Format.Path(nil)).to.equal("something")
		end)
	end)

	describe("Clock", function()
		it("counts seconds then minutes and seconds", function()
			expect(Format.Clock(7)).to.equal("7s")
			expect(Format.Clock(60)).to.equal("1m 0s")
			expect(Format.Clock(125)).to.equal("2m 5s")
		end)
	end)

	describe("Until", function()
		it("steps from minutes to hours as the reset moves away", function()
			expect(Format.Until(os.time() + 30)).to.equal("Resets in under a minute")
			expect(Format.Until(os.time() + 600)).to.equal("Resets in 10 min")
			expect(Format.Until(os.time() + 3600 * 4 + 60 * 27 + 5)).to.equal("Resets in 4 hr 27 min")
			expect(Format.Until(os.time() + 86400 * 2):match("^Resets %a%a%a ")).never.to.equal(nil)
		end)
	end)

	describe("Ago", function()
		it("rounds to the coarsest unit that has passed", function()
			expect(Format.Ago(os.time())).to.equal("just now")
			expect(Format.Ago(os.time() - 50)).to.equal("1m ago")
			expect(Format.Ago(os.time() - 60 * 12)).to.equal("12m ago")
			expect(Format.Ago(os.time() - 3600 * 3)).to.equal("3h ago")
		end)
	end)

	describe("IsLimit", function()
		it("recognises the ways a limit is worded and nothing else", function()
			expect(Format.IsLimit("You've hit your usage limit · resets 3pm")).to.equal(true)
			expect(Format.IsLimit("Session limit reached")).to.equal(true)
			expect(Format.IsLimit("Rate limit exceeded")).to.equal(true)
			expect(Format.IsLimit("Out of credits")).to.equal(true)
			expect(Format.IsLimit("Could not reach the bridge")).to.equal(false)
			expect(Format.IsLimit("")).to.equal(false)
		end)
	end)

	describe("ResetsAt", function()
		it("pulls the clock time out of a limit message", function()
			expect(Format.ResetsAt("You've hit your session limit · resets at 3:00 PM (America/Los_Angeles)")).to.equal("3:00 PM")
			expect(Format.ResetsAt("limit reached, resets 11pm")).to.equal("11pm")
			expect(Format.ResetsAt("resets at    4:30   pm")).to.equal("4:30 pm")
		end)

		it("gives nothing when no time is named", function()
			expect(Format.ResetsAt("You've hit your limit")).to.equal(nil)
		end)
	end)

	describe("Model", function()
		it("turns an SDK id into a name", function()
			expect(Format.Model("claude-sonnet-5")).to.equal("Sonnet 5")
			expect(Format.Model("claude-opus-4-8")).to.equal("Opus 4.8")
			expect(Format.Model("haiku")).to.equal("Haiku")
			expect(Format.Model("")).to.equal("")
		end)
	end)
end